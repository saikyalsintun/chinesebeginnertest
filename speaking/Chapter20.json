      "questions": [
        {
          "id": "ch20-p1-q1",
          "question": "မင်းကျောင်းကို ဘယ်လိုသွားလဲ။",
          "answer": "Nǐ zěnme qù xuéxiào?"
        },
        {
          "id": "ch20-p1-q2",
          "question": "ကျွန်တော် မော်တော်ဆိုင်ကယ်စီးပြီး ကျောင်းသွားတယ်။",
          "answer": "Wǒ qí mótuōchē qù xuéxiào."
        },
        {
          "id": "ch20-p1-q3",
          "question": "မင်းခရီးသွားရင် ဘယ်လိုသွားလဲ။",
          "answer": "Nǐ zěnme qù lǚxíng?"
        },
        {
          "id": "ch20-p1-q4",
          "question": "ကျွန်တော် ရထားစီးပြီး ခရီးသွားတယ်။",
          "answer": "Wǒ zuò huǒchē qù lǚxíng."
        },
        {
          "id": "ch20-p1-q5",
          "question": "အဖေက ဒီနေ့ အရမ်းအလုပ်များလို့ မင်းကို သွားမကြိုနိုင်တော့ဘူး။",
          "answer": "Bàba jīntiān hěn máng jiù bú qù jiē nǐ le."
        },
        {
          "id": "ch20-p1-q6",
          "question": "ကိစ္စမရှိပါဘူး။ ကျွန်တော် တက္ကစီစီးပြီး ပြန်လာမယ်။",
          "answer": "Méishì. Wǒ zuò chūzūchē huí lái."
        },
        {
          "id": "ch20-p1-q7",
          "question": "မင်း လေယာဉ်နဲ့ သင်္ဘောစီးဖူးလား။",
          "answer": "Nǐ yǒu méiyǒu zuòguo fēijī hé chuán ne?"
        },
        {
          "id": "ch20-p1-q8",
          "question": "ကျွန်တော် လေယာဉ်ပဲ စီးဖူးတယ်။ သင်္ဘောမစီးဖူးဘူး။",
          "answer": "Wǒ zhǐ zuòguo fēijī. Méiyǒu zuòguo chuán."
        },
        {
          "id": "ch20-p1-q9",
          "question": "ရှောင်လင်း၊ ဒါက ငါ့အိမ်ရဲ့ ကားအသစ်ပါ။",
          "answer": "Xiǎolíng, zhè shì wǒ jiā de xīnchē."
        },
        {
          "id": "ch20-p1-q10",
          "question": "တကယ်လှတယ်။",
          "answer": "Zhēn hǎo kàn."
        },
        {
          "id": "ch20-p1-q11",
          "question": "ဘယ်အချိန်က ဝယ်ခဲ့တာလဲ။",
          "answer": "Shénme shíhou mǎide?"
        },
        {
          "id": "ch20-p1-q12",
          "question": "မနေ့က အဖေဝယ်ခဲ့တာ။",
          "answer": "Zuótiān wǒ bàba mǎide."
        },
        {
          "id": "ch20-p1-q13",
          "question": "သူ ကားမောင်းပြီး အလုပ်သွားလား။",
          "answer": "Tā kāichē qù shàngbān ma?"
        },
        {
          "id": "ch20-p1-q14",
          "question": "ကားမောင်းပြီး သွားတာ။",
          "answer": "Kāi qù de."
        },
        {
          "id": "ch20-p1-q15",
          "question": "မင်းအစ်ကိုနဲ့ အစ်မက အလုပ်ကို ဘယ်လိုသွားကြလဲ။",
          "answer": "Nǐ gēge hé jiějie zěnme qù gōngzuò?"
        },
        {
          "id": "ch20-p1-q16",
          "question": "ငါ့အစ်ကိုက စက်ဘီးစီးတယ်။ ငါ့အစ်မက ဘတ်စ်ကားစီးတယ်။",
          "answer": "Wǒ gēge qí zìxíngchē. Wǒ jiějie zuò bāshì."
        },
        {
          "id": "ch20-p1-q17",
          "question": "ငါကတော့ မြေအောက်ရထားစီးပြီး ကျောင်းသွားတာကို ပိုကြိုက်တယ်။",
          "answer": "Wǒ háishì xǐhuān zuò dìtiě qù xuéxiào."
        },
        {
          "id": "ch20-p1-q18",
          "question": "ငါလည်းအတူတူပဲ။ ငါတို့ လမ်းလျှောက်သွားကြရအောင်။",
          "answer": "Wǒ yě shì. Wǒmen zǒu ba."
        }
      ]
