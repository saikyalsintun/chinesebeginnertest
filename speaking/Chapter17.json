    "part1": {
      "title": "Translation",
      "instruction": "Translate the Burmese sentence into Chinese Pinyin.",
      "questions": [
        {
          "id": "ch17-p1-q1",
          "question": "ဆရာ၊ မင်္ဂလာပါ။ ဘာများကူညီပေးရမလဲ။",
          "answer": "Xiānsheng, nǐ hǎo. Qǐngwèn yǒu shénme kěyǐ bāng nín de ma?"
        },
        {
          "id": "ch17-p1-q2",
          "question": "မင်္ဂလာပါ။ ဒီဘောင်းဘီမှာ တခြားအရောင်ရှိလား။",
          "answer": "Nǐ hǎo. Zhè tiáo kùzi yǒu biéde yánsè ma?"
        },
        {
          "id": "ch17-p1-q3",
          "question": "ဒီမှာ အနီရောင်၊ အနက်ရောင်၊ အဖြူရောင်နဲ့ အပြာရောင်ရှိတယ်။",
          "answer": "Zhège yǒu hóngsè, hēisè, báisè hé lánsè."
        },
        {
          "id": "ch17-p1-q4",
          "question": "အနက်ရောင်ကို လိုချင်တယ်။ ဘယ်လောက်လဲ။",
          "answer": "Wǒ yào hēisè de. Duōshǎo qián?"
        },
        {
          "id": "ch17-p1-q5",
          "question": "နှစ်သောင်းငါးထောင် မြန်မာငွေပါ။",
          "answer": "Liǎngwàn wǔqiān miǎnbì."
        },
        {
          "id": "ch17-p1-q6",
          "question": "ကောင်းပြီ။ ဒါကိုပဲယူမယ်။",
          "answer": "Hǎo. Jiù yào zhège."
        },
        {
          "id": "ch17-p1-q7",
          "question": "ကျေးဇူးတင်ပါတယ်။ နောက်တစ်ခါလည်း ပြန်လာပါ။",
          "answer": "Xièxie. Huānyíng xiàcì zài lái."
        },
        {
          "id": "ch17-p1-q8",
          "question": "ကောင်းပါပြီ။ နောက်တစ်ခါလည်း လာဦးမယ်။",
          "answer": "Hǎo de. Wǒ xiàcì háihuì lái."
        },
        {
          "id": "ch17-p1-q9",
          "question": "မိန်းကလေး၊ မင်္ဂလာပါ။ ဘာလိုအပ်လို့ ကူညီပေးရမလဲ။",
          "answer": "Xiǎojiě, nǐ hǎo. Qǐngwèn yǒu shénme xūyào bāngmáng ma?"
        },
        {
          "id": "ch17-p1-q10",
          "question": "ဟုတ်ပါတယ်။ ဒီအင်္ကျီကို စမ်းဝတ်ကြည့်လို့ရလား။",
          "answer": "Shì de. Zhè jiàn yīfu kěyǐ shì yíxià ma?"
        },
        {
          "id": "ch17-p1-q11",
          "question": "ဒီအဖြူရောင်ကို စမ်းလို့မရဘူး။ အနက်ရောင်ကို ယူပေးမယ်၊ စမ်းကြည့်ပါ။",
          "answer": "Zhège báisè bù néng shì. Wǒ gěi nǐ ná hēisè de shì yíxià."
        },
        {
          "id": "ch17-p1-q12",
          "question": "ကောင်းပါပြီ။ ကိစ္စမရှိပါဘူး။",
          "answer": "Hǎo de. Méishì."
        },
        {
          "id": "ch17-p1-q13",
          "question": "ဒီဟာကို မင်းအတွက်ပေးမယ်။",
          "answer": "Zhège gěi nǐ."
        },
        {
          "id": "ch17-p1-q14",
          "question": "တောင်းပန်ပါတယ်၊ အဝတ်လဲခန်းက ဘယ်မှာလဲ။",
          "answer": "Qǐngwèn shìyìjiān zài nǎr?"
        },
        {
          "id": "ch17-p1-q15",
          "question": "တည့်တည့်သွားပြီး ဘယ်ဘက်ကွေ့ရင် ရောက်ပြီ။",
          "answer": "Zhí zǒu zuǒ zhuǎn jiù shì le."
        },
        {
          "id": "ch17-p1-q16",
          "question": "အိုကေ။ ကျေးဇူးတင်ပါတယ်။",
          "answer": "Xíng. Xièxie."
        },
        {
          "id": "ch17-p1-q17",
          "question": "ရပါတယ်။",
          "answer": "Bú kèqì."
        }
      ]
    },
