      "questions": [
        {
          "id": "ch11-p1-q1",
          "question": "လူတိုင်းက မီးသတ်သမားရဲ့ သတ္တိကို အရမ်းလေးစားကြတယ်။",
          "answer": "Měige rén dōu hěn pèifú xiāofángyuán de yǒngqì."
        },
        {
          "id": "ch11-p1-q2",
          "question": "သူက အကြောင်းမရှိဘဲ မကြာခဏ စိတ်ဆိုးတတ်တယ်။",
          "answer": "Tā cháng wúyuánwúgù shēngqì."
        },
        {
          "id": "ch11-p1-q3",
          "question": "သူက အချိန်ပိုအလုပ်လုပ်ရတာကို မုန်းတယ်။",
          "answer": "Tā tǎoyàn jiābān."
        },
        {
          "id": "ch11-p1-q4",
          "question": "ဆရာက ကျောင်းသားတွေရဲ့ အမှတ်တွေကို အရမ်းစိတ်ပျက်တယ်။",
          "answer": "Lǎoshī duì xuéshengmen de chéngjì hěn shīwàng."
        },
        {
          "id": "ch11-p1-q5",
          "question": "သူက ဒီရုပ်ရှင်က အရမ်းပျင်းစရာကောင်းတယ်လို့ ထင်တယ်။",
          "answer": "Tā juéde zhè bù diànyǐng wúliáo jí le."
        },
        {
          "id": "ch11-p1-q6",
          "question": "ကျွန်တော်/ကျွန်မ နေ့တိုင်း အရမ်းပျော်တယ်။",
          "answer": "Wǒ měitiān dōu hěn kāixīn."
        },
        {
          "id": "ch11-p1-q7",
          "question": "ကျွန်တော်/ကျွန်မ အရမ်းဝမ်းနည်းတယ်။",
          "answer": "Wǒ hěn nánguò."
        },
        {
          "id": "ch11-p1-q8",
          "question": "ညီမလေးက ပျော်လွန်းလို့ ငိုလိုက်တယ်။",
          "answer": "Mèimei gāoxìng de kū le."
        },
        {
          "id": "ch11-p1-q9",
          "question": "သူက ပြုံးပြီး ကျွန်တော်/ကျွန်မ အရမ်းကောင်းတယ်လို့ ပြောတယ်။",
          "answer": "Tā xiào zhe shuō wǒ hěn hǎo."
        },
        {
          "id": "ch11-p1-q10",
          "question": "ကျွန်တော်/ကျွန်မ မကြောက်ဘူး။",
          "answer": "Wǒ bú hàipà."
        },
        {
          "id": "ch11-p1-q11",
          "question": "ဒီနေ့ အစည်းအဝေးက အရမ်းအောင်မြင်တယ်။",
          "answer": "Jīntiān de huìyì hěn chénggōng."
        }
      ]
    },
