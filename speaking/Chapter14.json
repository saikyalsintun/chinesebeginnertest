      "questions": [
        {
          "id": "ch14-p1-q1",
          "question": "မကြာသေးခင်က ဒူးရင်းသီးစားချင်နေတယ်။",
          "answer": "Wǒ zuìjìn xiǎng chī liúlián le."
        },
        {
          "id": "ch14-p1-q2",
          "question": "အခုက သရက်သီးရာသီပါ။",
          "answer": "Xiànzài shì mángguǒ jìjié."
        },
        {
          "id": "ch14-p1-q3",
          "question": "ကျွန်တော်/ကျွန်မ အကြိုက်ဆုံးစားတဲ့ သစ်သီးတွေက စပျစ်သီးနဲ့ ငှက်ပျောသီးပါ။",
          "answer": "Wǒ zuì àichī de shuǐguǒ shì pútáo hé xiāngjiāo."
        },
        {
          "id": "ch14-p1-q4",
          "question": "နေ့တိုင်း လိမ္မော်သီးတစ်လုံးစားတာ ကျန်းမာရေးအတွက်ကောင်းတယ်။",
          "answer": "Měitiān chī yí gè júzi duì shēntǐ hǎo."
        },
        {
          "id": "ch14-p1-q5",
          "question": "ဒီဟာမီသီးက အရမ်းချိုတယ်။",
          "answer": "Zhège hāmìguā hěn tián."
        },
        {
          "id": "ch14-p1-q6",
          "question": "သံပုရာသီးက အရမ်းချဉ်တယ်။",
          "answer": "Níngméng hǎo suān."
        },
        {
          "id": "ch14-p1-q7",
          "question": "ဖရဲသီးဖျော်ရည်တစ်ခွက် လိုချင်တယ်။",
          "answer": "Wǒ yào yì bēi xīguāzhi."
        },
        {
          "id": "ch14-p1-q8",
          "question": "နင် နာနတ်သီးနဲ့ မင်းကျွတ်သီးတွေ မဝယ်တော့ဘူးလား။",
          "answer": "Nǐ bú mǎi bōluó hé shānzhú le ma?"
        },
        {
          "id": "ch14-p1-q9",
          "question": "ကမ်းခြေမှာ အုန်းသီးတွေအများကြီးရှိတယ်။",
          "answer": "Zài hǎibiān yǒu hěn duō yēzi."
        },
        {
          "id": "ch14-p1-q10",
          "question": "တရုတ်နိုင်ငံမှာ သစ်တော်သီးတွေက ဈေးကြီးတယ်။",
          "answer": "Zài Zhōngguó luòlí hěn guì."
        },
        {
          "id": "ch14-p1-q11",
          "question": "ဒီနေ့ စူပါမားကတ်ကို သွားချင်တယ်။",
          "answer": "Wǒ jīntiān yào qù chāoshì."
        },
        {
          "id": "ch14-p1-q12",
          "question": "နင် ငါနဲ့အတူ သွားချင်လား။",
          "answer": "Nǐ yào hé wǒ qù ma?"
        },
        {
          "id": "ch14-p1-q13",
          "question": "မသွားတော့ဘူး။",
          "answer": "Wǒ bú qù le."
        },
        {
          "id": "ch14-p1-q14",
          "question": "စတော်ဘယ်ရီကိတ်မုန့်နဲ့ နဂါးမောက်သီး ၁၀ လုံး ဝယ်ပေးနိုင်မလား။",
          "answer": "Nǐ kěyǐ bāng wǒ mǎi cǎoméi dàngāo hé shí gè huǒlóng guǒ ma?"
        },
        {
