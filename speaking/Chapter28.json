      "questions": [
        {
          "id": "ch28-p1-q1",
          "question": "သူက တရုတ်ဘာသာသင်ခန်းစာ တက်နေတယ်။",
          "answer": "Tā zhèngzài shàng Zhōngwén kè."
        },
        {
          "id": "ch28-p1-q2",
          "question": "မနေ့က သင်ပေးခဲ့တဲ့ သင်ခန်းစာမှာ အားလုံး ပြဿနာရှိလား။",
          "answer": "Zuótiān jiāo de kèchéng, dàjiā yǒu méiyǒu wèntí?"
        },
        {
          "id": "ch28-p1-q3",
          "question": "ဆရာ၊ ကျွန်တော့်မှာ မေးစရာရှိတယ်။",
          "answer": "Lǎoshī, wǒ yǒu wèntí."
        },
        {
          "id": "ch28-p1-q4",
          "question": "ဒီဝါကျက မှန်လား။",
          "answer": "Zhège jùzi shì duìde ma?"
        },
        {
          "id": "ch28-p1-q5",
          "question": "အရမ်းမှန်တယ်။",
          "answer": "Fēicháng zhèngquè."
        },
        {
          "id": "ch28-p1-q6",
          "question": "ဒါပေမယ့် ကျွန်တော် မရှင်းသေးဘူး။",
          "answer": "Kěshì wǒ háishì bù qīngchu."
        },
        {
          "id": "ch28-p1-q7",
          "question": "ကျေးဇူးပြုပြီး ထပ်ရှင်းပြပေးလို့ရမလား။",
          "answer": "Kěyǐ qǐng nín zài jiěshì yíbiàn ma?"
        },
        {
          "id": "ch28-p1-q8",
          "question": "အတန်းဖော်အားလုံး နားလည်ပြီလား။",
          "answer": "Tóngxuémen dōu dǒng le ma?"
        },
        {
          "id": "ch28-p1-q9",
          "question": "ဒီနေ့သင်ခန်းစာက ဒီလောက်နဲ့ပဲ ပြီးပြီ။",
          "answer": "Jīntiān de kè jiù dào zhèlǐ."
        },
        {
          "id": "ch28-p1-q10",
          "question": "အားလုံး ပြန်တွေ့မယ်။ အိမ်ပြန်ရင် အိမ်စာရေးဖို့ မမေ့နဲ့။",
          "answer": "Dàjiā zàijiàn! Huíjiā jìdé xiě zuòyè."
        },
        {
          "id": "ch28-p1-q11",
          "question": "ဘုတ်ပြားကို နံရံပေါ်မှာ ချိတ်ထားတယ်။",
          "answer": "Báibǎn guàzài qiáng shàng."
        },
        {
          "id": "ch28-p1-q12",
          "question": "ခဲတံဖျက်ရတာ လွယ်တယ်၊ ပြီးတော့ တခြားစာလုံးတွေကို ထပ်ရေးလို့ရတယ်။",
          "answer": "Cā fěnbǐ zì hěn róngyì, ránhòu nǐ kéyǐ zài xiě qítā zì."
        },
        {
          "id": "ch28-p1-q13",
          "question": "စာမေးပွဲအောင်ဖို့ ဒီအချက်အလက်တွေကို လေ့လာရမယ်။",
          "answer": "Yào tōngguò kǎoshì, nǐ děi xuéxí zhèxiē zīliào."
        },
        {
          "id": "ch28-p1-q14",
          "question": "ကျွန်တော် ဘောပင်နဲ့ မှတ်စုရေးတယ်၊ ဘောပင်နဲ့ရေးရတာ လွယ်လို့ပါ။",
          "answer": "Wǒ yòng gāngbǐ jì bǐjì, yīnwéi gāngbǐ xiěqǐlái hěn róngyì."
        },
        {
          "id": "ch28-p1-q15",
          "question": "ကျွန်တော်တို့ စာသင်ခန်းထဲမှာ ပရိုဂျက်တာတစ်လုံးရှိတယ်၊ ရုပ်ရှင်ကြည့်ဖို့ အသုံးပြုလို့ရတယ်။",
          "answer": "Wǒmen jiàoshì lǐ yǒu yī tái fàngyìngjī, kěyǐ yònglái kàn diànyǐng."
        },
        {
          "id": "ch28-p1-q16",
          "question": "ကျွန်တော်တို့ ဘာသာရပ်တိုင်းမှာ မှတ်စုစာအုပ်တစ်အုပ်ရှိတယ်။",
          "answer": "Wǒmen méi zhǒng kè dōu yǒu yígè bǐjìběn."
        }
      ]
